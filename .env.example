# ---------------------------------------------------------------------------
# PipelinePrep environment. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Public origin. Used for metadata, OG tags, sitemap, and Razorpay redirects.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string.
#   local docker-compose: postgresql://pipelineprep:pipelineprep@localhost:5432/pipelineprep?schema=public
#   RDS:                 postgresql://USER:PASS@HOST:5432/pipelineprep?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://pipelineprep:pipelineprep@localhost:5432/pipelineprep?schema=public"

# Session + token signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-change-me-please-generate-a-long-random-string"

# Set to "production" in AWS. Enables secure cookies, HSTS and strict behaviour.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Google sign-in (optional)
# ---------------------------------------------------------------------------
# Both values are required for Google sign-in to be offered. With either one
# blank the "Continue with Google" button is not rendered at all, and the app
# behaves exactly as it did before: email and password only.
#
# To create them:
#   1. Google Cloud Console > select or create a project
#   2. "APIs & Services" > "OAuth consent screen" > configure, add your app
#   3. "Credentials" > "Create credentials" > "OAuth client ID" > "Web application"
#   4. Under "Authorised redirect URIs" add EXACTLY:
#        http://localhost:3000/api/auth/google/callback
#        https://YOUR-DOMAIN/api/auth/google/callback
#      The value must match byte for byte, including scheme, host, port and the
#      absence of a trailing slash. A mismatch fails at the token exchange with
#      `redirect_uri_mismatch`, which is Google's error, not a bug here.
#
# The secret is server-only. It travels in the authorisation-code exchange and
# is never sent to the browser, so it does not need to be a public "client
# secret" in the native-app sense.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional. Defaults to `${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback`, which
# is correct in almost every case. Set it only if Google redirects somewhere
# else, for example when a proxy rewrites the public host.
GOOGLE_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Payments - Razorpay
# ---------------------------------------------------------------------------
# Leave the keys empty to run in "no gateway" mode: checkout and the webhook
# route return a clear error instead of crashing, and the admin can grant
# premium manually (P-8).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Signature verification secret from `Razorpay Dashboard > Settings > Webhooks`.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Email (transactional). Leave SMTP_HOST empty to log emails to the console.
# For AWS, use Amazon SES SMTP credentials.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="PipelinePrep <no-reply@pipelineprep.in>"

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# Career Tools teaser: waitlist capture and landing page only. There is no
# resume upload, no document parsing and no AI integration in this codebase.
# Set to "true" to show the teaser; false hides the UI and 404s the routes.
CAREER_TOOLS_ENABLED=false

# ---------------------------------------------------------------------------
# Business config
# ---------------------------------------------------------------------------
# Used on invoices and the legal pages.
BUSINESS_NAME="PipelinePrep"
BUSINESS_GSTIN=""
BUSINESS_ADDRESS=""
BUSINESS_SUPPORT_EMAIL="support@pipelineprep.in"
SUPPORT_PHONE=""

# Stripe/Razorpay tax: GST inclusive pricing. 18% for online education services.
GST_RATE=18

# Career Tools teaser (waitlist only). Can also be toggled at /admin/settings.
CAREER_TOOLS_ENABLED=false

# ---------------------------------------------------------------------------
# Scheduled housekeeping
# ---------------------------------------------------------------------------
# Guards `POST /api/health`, which expires subscriptions that lapsed without a
# page view. Entitlement checks already flip these lazily on read, so this only
# affects reporting accuracy. Leave blank in development to skip the check.
#
# In production, set this AND schedule the call (EventBridge Scheduler ->
# Lambda, or a systemd timer). The endpoint returns 401 without a matching
# bearer token, so a blank value in production would leave it effectively open.
#
#   curl -X POST https://YOUR-DOMAIN/api/health -H "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
